PORT=4000
DATABASE_URL=postgres://sorteos:sorteos@db:5432/sorteos
JWT_SECRET=cambiar-por-un-texto-largo-y-aleatorio
ADMIN_EMAIL=admin@tudominio.com.ar
# node -e "console.log(require('bcryptjs').hashSync('tuClave',10))"
ADMIN_PASSWORD_HASH=
# (opcional) usuario (puede ser un nombre, ej. Angelo) que solo puede hacer el sorteo en vivo, sin ver compradores ni recaudación
LIVE_EMAIL=
LIVE_PASSWORD_HASH=
FRONTEND_URL=http://localhost:3000
# URL pública de esta API (para el webhook de MP; en local usar ngrok)
PUBLIC_API_URL=https://api.tudominio.com.ar
# Mercado Pago > Tus integraciones > Credenciales (usar las de prueba primero)
MP_ACCESS_TOKEN=TEST-xxxxxxxx
# Mercado Pago > Tus integraciones > Webhooks > Clave secreta
MP_WEBHOOK_SECRET=
# API de Mercado Pago para crear el checkout: orders (por defecto) o preferences (heredada)
# MP_API=orders
# Carpeta donde se guardan los PDF de los cursos (fuera del repo)
STORAGE_DIR=./storage
# En Railway: montar un volumen en /data y usar STORAGE_DIR=/data/storage
MAX_PDF_MB=20
# Validez de los links de descarga de cursos
DOWNLOAD_LINK_HOURS=72
# Email transaccional. Vacío = los mails se muestran en la consola.
# Recomendado: API de Resend (funciona en cualquier plan; Railway bloquea el SMTP fuera del plan Pro)
RESEND_API_KEY=
# Alternativa por SMTP (solo si se usa RESEND_API_KEY vacío):
# Resend: smtps://resend:re_xxx@smtp.resend.com:465 · Brevo: smtp://usuario:clave@smtp-relay.brevo.com:587
SMTP_URL=
MAIL_FROM="Zona Norte Automotores <sorteos@tudominio.com.ar>"
MAIL_REPLY_TO=
# Marca en los emails
BRAND_NAME=AUTO SORTEOS
BRAND_COLOR=#e3262f
BRAND_LOGO_URL=
BRAND_WHATSAPP_URL=

# Participación gratuita ("sin obligación de compra")
# Captcha Cloudflare Turnstile (gratis). Sin TURNSTILE_SECRET queda desactivado: usarlo siempre en producción.
TURNSTILE_SECRET=
FREE_ENTRIES_PER_IP_PER_DAY=5
FREE_ENTRY_CONFIRM_HOURS=24
# Horas durante las que una compra sin pago se considera "en curso" (antes del control previo al sorteo)
PENDING_GRACE_HOURS=24

# Monitor de la conexión con Mercado Pago: cada cuántos minutos se chequea (por defecto 5)
# y a quién se avisa si se cae (por defecto, al ADMIN_EMAIL; varios separados por coma)
MP_HEALTH_INTERVAL_MIN=5
ALERT_EMAILS=

# Envío de emails: lotes, paralelismo y límite de velocidad (ajustar al plan del proveedor)
EMAIL_BATCH_SIZE=50
EMAIL_CONCURRENCY=5
# Máximo de mails por segundo (0 = sin límite)
EMAIL_RATE_PER_SEC=5
EMAIL_POLL_SECONDS=5
# Con el envío en un servicio aparte (src/worker.js), en la API poner EMAIL_WORKER=off y EMAIL_IMMEDIATE=off
EMAIL_WORKER=on
EMAIL_IMMEDIATE=on

# Exportación del listado completo: filas que se leen de la base por tanda
EXPORT_BATCH_SIZE=2000
