# URL de la API en producción (en desarrollo se usa el proxy de package.json)
REACT_APP_API_URL=https://api.tudominio.com.ar
# Clave PÚBLICA de Cloudflare Turnstile (la secreta va solo en el backend)
REACT_APP_TURNSTILE_SITEKEY=
# Medición opcional (se activa solo si hay IDs y la persona acepta las cookies)
REACT_APP_META_PIXEL_ID=
REACT_APP_GA_ID=
